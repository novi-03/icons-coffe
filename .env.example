# ---------------------------------------------------------------------------
# ICONS Coffee — environment configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public HTTPS address customers reach. Used in table QR codes and payment redirects.
PUBLIC_URL=https://order.your-domain.ae

# Runtime connection — MUST use the non-owner role "icons_app" so Row Level Security applies.
DATABASE_URL=postgres://icons_app:CHANGE_ME@db-host:5432/icons_coffee
# Owner connection used only by `npm run db:migrate` / `db:seed` / `db:reset`.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@db-host:5432/icons_coffee
# Password that the migration assigns to the icons_app role (must match DATABASE_URL).
APP_DB_PASSWORD=CHANGE_ME

# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=

RESTAURANT_SLUG=icons-coffee

# Stripe (online payments). Leave empty to disable online payment — cash/counter still work.
STRIPE_SECRET_KEY=
# Optional but recommended: signing secret of the webhook endpoint PUBLIC_URL/api/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.async_payment_failed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# Demo helpers (home-page table links + account e-mails). Never enable in production.
DEMO_MODE=false
# Optional: fixed password for all seeded demo accounts (otherwise random per seed).
# DEMO_PASSWORD=

# Set to true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting).
TRUST_PROXY=false
# Cookies are Secure in production by default; override only for plain-HTTP testing.
# COOKIE_SECURE=false
